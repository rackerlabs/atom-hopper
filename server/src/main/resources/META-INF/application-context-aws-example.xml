<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- 
    ========================================================================
    AWS Secrets Manager Integration Example Configuration
    ========================================================================
    
    This file demonstrates how to configure AWS Secrets Manager integration
    for Atom Hopper. This configuration is OPTIONAL and only needed if you
    want to use AWS Secrets Manager for storing sensitive configuration.
    
    To enable AWS Secrets Manager:
    1. Uncomment the beans below
    2. Configure AWS credentials and region
    3. Use placeholders in your bean properties: ${aws-secretsmanager:secret-name}
    
    ========================================================================
    -->

    <!-- 
    ========================================================================
    Step 1: Register the PropertySource Registrar
    ========================================================================
    This bean registers the AWS Secrets Manager PropertySource with Spring.
    It must be defined before any beans that use AWS Secrets Manager placeholders.
    -->
