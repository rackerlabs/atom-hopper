    <!-- ========================================================================
         Additional AWS Secrets Manager Usage Examples
         ======================================================================== -->
    
    <!-- EXAMPLE 1: Simple string secret (API key, token, etc.) -->
    <!--
    Assumes a secret named "atomhopper/api-key" containing a plain string value
    
    <bean id="externalApiClient" class="com.example.ApiClient">
        <property name="apiKey" value="${aws-secretsmanager:atomhopper/api-key}" />
    </bean>
    -->
    
    <!-- EXAMPLE 2: Multiple secrets from different sources -->
    <!--
    Mix AWS Secrets Manager with environment variables and property files
    
    <bean id="configuredService" class="com.example.ConfiguredService">
        <property name="dbPassword" value="${aws-secretsmanager:db/password}" />
        <property name="apiEndpoint" value="${API_ENDPOINT:http://localhost:8080}" />
        <property name="timeout" value="${service.timeout:30000}" />
    </bean>
    -->
    
    <!-- EXAMPLE 3: MongoDB with AWS Secrets Manager -->
    <!--
    Assumes a secret named "atomhopper/mongodb" with JSON structure:
    {
      "username": "mongouser",
      "password": "secure-mongo-password"
    }
    
    <mongo:db-factory id="mongoDbFactory"
            dbname="atomhopper"
            username="${aws-secretsmanager:atomhopper/mongodb/username}"
            password="${aws-secretsmanager:atomhopper/mongodb/password}"
            mongo-ref="mongo"/>
    -->
    
    <!-- EXAMPLE 4: Entire connection string from single secret -->
    <!--
    Assumes a secret named "atomhopper/jdbc-url" containing the full JDBC URL
    
    <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource">
        <property name="url" value="${aws-secretsmanager:atomhopper/jdbc-url}" />
        <property name="username" value="${aws-secretsmanager:atomhopper/db/credentials/username}" />
        <property name="password" value="${aws-secretsmanager:atomhopper/db/credentials/password}" />
    </bean>
    -->
    
    <!-- EXAMPLE 5: Default values with AWS Secrets Manager -->
    <!--
    Use Spring's default value syntax with AWS Secrets Manager placeholders
    Falls back to default if secret doesn't exist or AWS is not configured
    
    <bean id="serviceConfig" class="com.example.ServiceConfig">
        <property name="password" value="${aws-secretsmanager:optional/secret:defaultPassword}" />
    </bean>
    -->
    
</beans>
