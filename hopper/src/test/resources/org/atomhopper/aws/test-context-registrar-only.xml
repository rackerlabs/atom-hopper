<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- Register AWS PropertySource registrar but no AWS client -->
    <!-- This tests graceful degradation when AWS is not fully configured -->
    
    <bean id="awsSecretsManagerPropertySourceRegistrar" 
          class="org.atomhopper.aws.AwsSecretsManagerPropertySourceRegistrar"/>

    <bean id="testBean" class="org.atomhopper.aws.TestBean">
        <property name="property" value="test-value"/>
    </bean>

</beans>
